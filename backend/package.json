{
  "name": "soule-menu-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute soule_menu_db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute soule_menu_db --remote --file=./src/db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "itty-router": "^5.0.0"
  }
}
